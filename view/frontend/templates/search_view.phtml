<?php
/** @var \GDMexico\GoogleTagManager\Block\Search $block */

if (!$block->canTrack()) {
    return;
}

$searchTerm = $block->getSearchTerm();
$items = $block->getItems();
$currencyCode = $block->getCurrencyCode();

$eventData = [
    'event' => 'search',
    'search_term' => $searchTerm,
    'ecommerce' => [
        'item_list_id' => 'search_results',
        'item_list_name' => 'Search Results',
        'currency' => $currencyCode,
        'items' => $items,
    ],
];
?>
<script>
    window.dataLayer = window.dataLayer || [];

    // Limpia ecommerce anterior para evitar que GTM mezcle datos de otro evento.
    window.dataLayer.push({ ecommerce: null });

    // Evento requerido al cargar resultados de búsqueda.
    window.dataLayer.push(<?= /* @noEscape */ json_encode(
        $eventData,
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ) ?>);

    <?php if ($block->isDebugEnabled()): ?>
    console.log('GTM search event:', <?= /* @noEscape */ json_encode(
        $eventData,
        JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    ) ?>);
    <?php endif; ?>
</script>
