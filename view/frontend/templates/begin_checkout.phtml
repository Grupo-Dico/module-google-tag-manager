<?php
/** @var \GDMexico\GoogleTagManager\Block\Gtm $block */
if (!$block->isEnabled()) {
    return;
}

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$checkoutSession = $objectManager->get(\Magento\Checkout\Model\Session::class);
$quote = $checkoutSession->getQuote();

if (!$quote || !$quote->getId()) {
    return;
}

$items = [];
$totalValue = 0;
$dataLayer = $block->getDataLayer();

foreach ($quote->getAllVisibleItems() as $item) {
    $product = $item->getProduct();
    if ($product) {
        // Obtener categoría del producto
        $categoryName = $dataLayer->getProductCategoryWithSmallestId($product);
        
        $itemData = [
            'item_id' => $product->getSku(),
            'item_name' => $product->getName(),
            'currency' => $quote->getQuoteCurrencyCode(),
            'price' => (float)$item->getPrice(),
            'quantity' => (int)$item->getQty(),
        ];
        
        // Agregar categoría si existe
        if ($categoryName) {
            $itemData['item_category'] = $categoryName;
        }
        
        // Agregar marca si existe
        $brand = $product->getAttributeText('manufacturer');
        if ($brand) {
            $itemData['item_brand'] = $brand;
        }
        
        $items[] = $itemData;
        $totalValue += $itemData['price'] * $itemData['quantity'];
    }
}

if (empty($items)) {
    return;
}
?>
<script>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
        'event': 'begin_checkout',
        'ecommerce': {
            'currency': '<?= $block->escapeJs($quote->getQuoteCurrencyCode()) ?>',
            'value': <?= $totalValue ?>,
            'items': <?= json_encode($items, JSON_UNESCAPED_UNICODE) ?>
        }
    });
    <?php if ($block->getHelper()->isDebugEnabled()): ?>
    console.log('GTM: Evento begin_checkout enviado');
    <?php endif; ?>
</script>

